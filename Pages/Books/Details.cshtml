@page
@model Rujoiu_Mihai_Lab2.Pages.Books.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Book</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Book.Title)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Book.Title)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Book.Author)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Book.Author.FullName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Book.Price)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Book.Price)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Book.PublishingDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Book.PublishingDate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Book.Publisher)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Book.Publisher.PublisherName)
        </dd>

        @* SECȚIUNEA NOUĂ: AFIȘAREA CATEGORIILOR CĂRȚII *@
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Book.BookCategories)
        </dt>
        <dd class="col-sm-10">
            @if (Model.Book.BookCategories != null && Model.Book.BookCategories.Any())
            {
                <ul>
                    @foreach (var categoryLink in Model.Book.BookCategories)
                    {
                        <li>
                            @categoryLink.Category.CategoryName
                        </li>
                    }
                </ul>
            }
            else
            {
                <span>Nicio categorie atribuită.</span>
            }
        </dd>
        @* SFÂRȘIT SECȚIUNE NOUĂ *@
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Book?.ID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
